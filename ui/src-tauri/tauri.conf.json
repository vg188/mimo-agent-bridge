{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MiMo Agent Bridge",
  "version": "0.2.0",
  "identifier": "com.mimo.agent.bridge",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "MiMo Agent Bridge",
        "width": 1180,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "theme": "Dark",
        "titleBarStyle": "Visible",
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "category": "DeveloperTool",
    "shortDescription": "MiMo subscription local API bridge",
    "longDescription": "Expose your MiMo Desktop subscription as OpenAI / Anthropic / Responses APIs for local agents.",
    "copyright": "© MiMo Agent Bridge",
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png", "icons/icon.png"],
    "resources": {
      "../../mimo_bridge": "mimo_bridge/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true
      }
    }
  }
}
